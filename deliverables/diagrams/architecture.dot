digraph G {
 graph [rankdir=LR, bgcolor="white", pad="0.28", nodesep="0.45", ranksep="0.68", splines=ortho, fontname="DejaVu Sans", fontsize=18, labelloc=t, label="ORBIT SIS  |  RUNTIME ARCHITECTURE\n", compound=true];
 node [shape=box, style="rounded,filled", color="#CBD5DF", fillcolor="#F7F9FC", fontname="DejaVu Sans", fontsize=11, fontcolor="#15283B", margin="0.18,0.13", penwidth=1.2];
 edge [fontname="DejaVu Sans", fontsize=9, color="#526A80", fontcolor="#3C5368", arrowsize=.75, penwidth=1.35];
 subgraph cluster_clients { label="CLIENTS & WORKLOADS"; color="#D7E0E8"; style="rounded"; penwidth=1.2;
  student [label="Student / faculty\nbrowser", fillcolor="#EAF2FF", color="#8AAFE6"];
  locust [label="Locust load\nworkloads", fillcolor="#F2F4F7"];
 }
 subgraph cluster_app { label="APPLICATION BOUNDARY  ·  FASTAPI MODULAR MONOLITH"; color="#9CCFC8"; style="rounded"; penwidth=1.5;
  api [label="HTTP API\nFastAPI", fillcolor="#DDF4EF", color="#5DAFA3", penwidth=1.6];
  auth [label="Authentication · role checks\nrequest validation", fillcolor="#F1FAF8", color="#9CCFC8"];
  domain [label="Academic workflows\ncourses · offerings · enrollment\ngrades · attendance · timetable", fillcolor="#F1FAF8", color="#9CCFC8"];
  aux [label="Process-local experiments\nTTL/LRU cache · token bucket\nhash ring · in-memory telemetry", fillcolor="#FFF4E8", color="#E4B77C"];
  api -> auth [label="validate / authorize"];
  auth -> domain [label="allowed request"];
  api -> aux [style=dashed, label="experimental routes"];
 }
 subgraph cluster_data { label="PERSISTENCE BOUNDARY"; color="#A8B8C8"; style="rounded"; penwidth=1.2;
  pg [label="PostgreSQL\nauthoritative academic state\nconstraints + transactions", fillcolor="#E7EEF5", color="#6888A5", penwidth=1.7];
 }
 student -> api [label="HTTPS / JSON"];
 locust -> api [label="HTTP workload"];
 domain -> pg [label="SQLAlchemy / SQL transaction", color="#087E78", fontcolor="#087E78", penwidth=1.8];
 aux -> pg [style=dashed, label="only persisted features\n(e.g. short links)"];
 note [shape=note, label="Correctness rule\nSeat counter + enrollment row\ncommit or roll back together", fillcolor="#FFF9E9", color="#D8B96E", fontsize=10];
 {rank=same; pg; note;} pg -> note [style=dotted, arrowhead=none, color="#B49A4D"];
}