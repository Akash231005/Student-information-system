@echo off
REM One command to bring the whole demo up on Windows: preflight, stack, data, API.
REM
REM   run.bat                start everything the demo needs
REM   run.bat --with-tests   also run the test suite first (it drops and recreates tables)
REM   run.bat --verify       also run scripts\verify_stack.py (live crawl, about a minute)
REM
REM UNTESTED: written against Docker Desktop but never executed on Windows (no Windows host
REM was available). The Linux path (run.sh) is the one that is proven. Differences from it are
REM forced by Docker Desktop: there is no host networking, so containers talk to each other by
REM container name on the sis-net network and reach the host through published ports.
setlocal enabledelayedexpansion
cd /d "%~dp0"
set "APP=%~dp0sis-app"
set "RUN=%APP%\.run"
set "API_PORT=8000"
set "WITH_TESTS=0"
set "VERIFY=0"

for %%a in (%*) do (
  if "%%a"=="--with-tests" set "WITH_TESTS=1"
  if "%%a"=="--verify" set "VERIFY=1"
)

echo.
echo ==^> Preflight
where docker >nul 2>&1 || goto :no_docker
docker version >nul 2>&1 || goto :no_docker_engine
echo     docker is reachable

where uv >nul 2>&1 || goto :no_uv
echo     uv is installed

where curl >nul 2>&1 || goto :no_curl

REM --- env file (gitignored, generated once) --------------------------------
if exist "%APP%\.env" goto :have_env
for /f "delims=" %%s in ('uv run python -c "import secrets;print(secrets.token_hex(32))"') do set "SECRET=%%s"
> "%APP%\.env" (
  echo # Generated by run.bat. Local development only - never commit this file.
  echo DATABASE_URL=postgresql+psycopg://sis:sis_dev_only@127.0.0.1:5432/sis
  echo SIS_ENV=development
  echo SIS_TOKEN_SECRET=!SECRET!
  echo SIS_REDIS_URL=redis://127.0.0.1:6379/0
  echo SIS_MONGO_URI=mongodb://127.0.0.1:27017
  echo SIS_MONGO_DB=sis
  echo SIS_RATE_LIMIT_ENABLED=true
)
echo     created sis-app\.env with a fresh token secret
:have_env

if not exist "%RUN%" mkdir "%RUN%"

echo.
echo ==^> Python dependencies ^(uv sync^)
if "%WITH_TESTS%"=="1" (uv sync --extra test --quiet) else (uv sync --quiet)
if errorlevel 1 goto :failed

echo.
echo ==^> Starting the state stores ^(PostgreSQL, Redis, MongoDB sharded cluster^)
docker network create sis-net >nul 2>&1
call :up sis-postgres   -e POSTGRES_DB=sis -e POSTGRES_USER=sis -e POSTGRES_PASSWORD=sis_dev_only -p 127.0.0.1:5432:5432 postgres:17-alpine
call :up sis-redis      -p 127.0.0.1:6379:6379 redis:7-alpine redis-server --maxmemory 128mb --maxmemory-policy allkeys-lru
call :up sis-mongo-cfg  -p 127.0.0.1:27019:27019 mongo:7.0 --configsvr --replSet sis-cfg --port 27019 --bind_ip_all
call :up sis-mongo-a    -p 127.0.0.1:27021:27021 mongo:7.0 --shardsvr --replSet sis-shard-a --port 27021 --bind_ip_all
call :up sis-mongo-b    -p 127.0.0.1:27022:27022 mongo:7.0 --shardsvr --replSet sis-shard-b --port 27022 --bind_ip_all
call :up sis-mongos     -p 127.0.0.1:27017:27017 mongo:7.0 --configdb sis-cfg/sis-mongo-cfg:27019

echo     waiting for containers to listen
timeout /t 8 /nobreak >nul

echo.
echo ==^> Initialising the replica sets and registering the shards
docker exec sis-mongo-cfg mongosh --port 27019 --quiet --eval "try{rs.status()}catch(e){rs.initiate({_id:'sis-cfg',configsvr:true,members:[{_id:0,host:'sis-mongo-cfg:27019'}]})}"
docker exec sis-mongo-a   mongosh --port 27021 --quiet --eval "try{rs.status()}catch(e){rs.initiate({_id:'sis-shard-a',members:[{_id:0,host:'sis-mongo-a:27021'}]})}"
docker exec sis-mongo-b   mongosh --port 27022 --quiet --eval "try{rs.status()}catch(e){rs.initiate({_id:'sis-shard-b',members:[{_id:0,host:'sis-mongo-b:27022'}]})}"
timeout /t 10 /nobreak >nul
docker exec sis-mongos mongosh --port 27017 --quiet --eval "try{sh.addShard('sis-shard-a/sis-mongo-a:27021')}catch(e){print('shard a already registered')};try{sh.addShard('sis-shard-b/sis-mongo-b:27022')}catch(e){print('shard b already registered')}"

if "%WITH_TESTS%"=="1" (
  echo.
  echo ==^> Test suite ^(drops and recreates tables, so it runs before seeding^)
  uv run --extra test pytest -q
  if errorlevel 1 goto :failed
)

echo.
echo ==^> Seeding the demo data
uv run python -m scripts.generate_dataset --students 1000 --courses 100 --offerings-per-course 2
uv run python -m scripts.seed_demo
uv run python -m scripts.create_staff --email staff@example.test --student-number STAFF001 --name "Demo Staff" --password sis-demo-2026

echo.
echo ==^> Starting the API
start "sis-api" /b "%APP%\.venv\Scripts\uvicorn.exe" app.main:app --host 127.0.0.1 --port %API_PORT% > "%RUN%\api.log" 2>&1

set "READY=0"
for /l %%i in (1,1,60) do (
  if "!READY!"=="0" (
    curl -fsS "http://127.0.0.1:%API_PORT%/health" >nul 2>&1 && set "READY=1"
    if "!READY!"=="0" timeout /t 1 /nobreak >nul
  )
)
if "%READY%"=="0" (
  echo     the API did not answer /health within 60s - last log lines:
  powershell -NoProfile -Command "Get-Content '%RUN%\api.log' -Tail 20"
  goto :failed
)

echo     health:
curl -fsS "http://127.0.0.1:%API_PORT%/health"
echo.

if "%VERIFY%"=="1" (
  echo.
  echo ==^> Verifying the real stores ^(measured, not asserted^)
  uv run python scripts\verify_stack.py
)

echo.
echo Everything is up.
echo   dashboard   http://127.0.0.1:%API_PORT%/
echo   API docs    http://127.0.0.1:%API_PORT%/docs
echo   staff login staff@example.test / sis-demo-2026
echo   stop        stop.bat
echo.
exit /b 0

:up
REM :up NAME [docker run args...] - start it, or reuse a stopped container of that name.
set "NAME=%~1"
shift
docker container inspect "%NAME%" >nul 2>&1
if errorlevel 1 (
  docker run -d --name "%NAME%" --network sis-net --restart unless-stopped %* >nul
  if errorlevel 1 (echo     FAILED to start %NAME% & exit /b 1)
  echo     %NAME% created
) else (
  docker start "%NAME%" >nul
  if errorlevel 1 (echo     FAILED to start %NAME% & exit /b 1)
  echo     %NAME% started
)
exit /b 0

:no_docker
echo     Docker Desktop is required and was not found.
echo       install it from https://docs.docker.com/desktop/setup/install/windows-install/
goto :failed

:no_docker_engine
echo     Docker is installed but the engine is not running.
echo       start Docker Desktop, wait for "Engine running", then re-run this script.
goto :failed

:no_uv
echo     uv is required: certutil-free install -
echo       powershell -ExecutionPolicy ByPass -c "irm https://astral.sh/uv/install.ps1 ^| iex"
goto :failed

:no_curl
echo     curl.exe is required and missing ^(it ships with Windows 10 1803+^).
goto :failed

:failed
echo.
echo Nothing was left half-started on purpose: fix the message above and re-run.
exit /b 1
