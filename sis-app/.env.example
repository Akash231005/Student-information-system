# Copy to .env for local development; replace the token secret before deployment.
DATABASE_URL=postgresql+psycopg://sis:sis_dev_only@localhost:5432/sis
SIS_ENV=development
SIS_TOKEN_SECRET=replace-with-a-random-secret-of-at-least-32-bytes

# Shared state. Redis holds the rate-limit buckets, the cache and the ID worker slots;
# SIS_MONGO_URI must point at the mongos router, not at a shard.
SIS_REDIS_URL=redis://127.0.0.1:6379/0
SIS_MONGO_URI=mongodb://127.0.0.1:27017
SIS_MONGO_DB=sis

SIS_RATE_LIMIT_ENABLED=true
SIS_RATE_LIMIT_CAPACITY=120
SIS_RATE_LIMIT_REFILL_PER_SECOND=10
SIS_CACHE_TTL_SECONDS=20
